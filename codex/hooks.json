{
  "description": "Notify when Codex requests approval.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/scripts/notifications/permission-request-notification.sh\"",
            "async": true
          }
        ]
      }
    ]
  }
}
